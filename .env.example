# Configuración de Passbolt CLI
# Copia este archivo a .env y completa con tus valores

# URL base de tu instancia de Passbolt (sin barra final)
PASSBOLT_URL=https://tu-passbolt.ejemplo.com

# Clave privada GPG en formato PEM (toda la clave, incluyendo -----BEGIN/END-----)
PRIVATE_KEY="-----BEGIN PGP PRIVATE KEY BLOCK-----
...tu clave privada completa aquí...
-----END PGP PRIVATE KEY BLOCK-----"

# Passphrase de tu clave GPG
PASSPHRASE=tu_passphrase_aqui