# Configuración de Passbolt
PASSBOLT_URL=https://passbolt.xxx.xx
RESOURCE_ID=xxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxx

# Clave privada PGP (mantener las comillas y saltos de línea)
